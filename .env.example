# Google OAuth client ID (Web application). Public value — safe to commit locally.
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Same client ID, read by the API function to validate the token audience.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Workspace domain allowed to sign in.
ALLOWED_EMAIL_DOMAIN=feiyutheater.org
VITE_ALLOWED_EMAIL_DOMAIN=feiyutheater.org
